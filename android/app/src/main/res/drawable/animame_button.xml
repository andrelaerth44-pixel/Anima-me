<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#17212A" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#263846" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#245A7A" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#5FC7E8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B2A35" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#31566B" />
        </shape>
    </item>
</selector>
